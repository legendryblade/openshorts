# Video files
*.mp4
*.webm
*.mov
*.mkv

# YOLO model
*.pt

# Python virtual environment
.venv/
.venv311/
__pycache__/
*.pyc

# Temporary files / runtime dirs
temp_*
uploads/
downloads/
videos/
output/

# OS / IDE
.DS_Store
.idea/
.vscode/

# Secrets
.env
# Backups made while swapping keys carry the same live API keys as .env itself.
.env.bak*

# Generated metadata
*_metadata.json

# Cache dirs
.cache/
.config/
# Multi-agent Skills
.agents/
.agent/
.claude/
# skills/ holds third-party installs (symlinks); our own published skill is versioned
skills/*
!skills/openshorts/
skills-lock.json


# Cloud env example kept local only (avoid leaking infra hints)
.env.cloud.example
.worktrees

# Job outputs and server runtime
output/
*.log
# The watchdog rotates on restart, and the rotated name ends in the timestamp.
*.log.[0-9]*

# PyInstaller / PyArmor build artifacts
build/
dist/
main.build/
main.dist/
.pyarmor/
*.spec.bak

# superseded UI backup (not for public repos)
static_ui/index.pre-redesign.html
tunnel-url.txt
