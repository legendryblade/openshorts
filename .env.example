# AWS S3 (optional — for clip backup/gallery)
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=eu-west-3
AWS_S3_BUCKET=your-bucket-name
AWS_S3_PUBLIC_BUCKET=your-public-bucket-name

# YouTube cookies (optional — paste Netscape-format cookies to bypass bot detection)
# YOUTUBE_COOKIES=...

# Google OAuth (cloud/billing mode only). When logging in through a proxy whose
# Host header doesn't match a Google-registered URI (e.g. local dev via the Vite
# proxy), pin the callback explicitly:
# OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
# FRONTEND_URL=http://localhost:5175

# Local dev: show the full pipeline logs (yt-dlp/ffmpeg/debug) in the UI even
# when running in paid mode (BILLING_ENABLED). Cloud/prod leaves this unset.
# DEBUG_LOGS=true

# Pre-flight quality gate: warn before processing a YouTube source below this
# height (720p default; 0 disables). Only applies to URL sources.
# QUALITY_GATE_MIN_HEIGHT=720

# Whisper transcription model (the local fallback; the cloud path uses
# GROQ_ASR_MODEL). "small" beats "base" on non-English audio and is the CPU
# compromise. Caption karaoke and word-boundary cuts both read word timings,
# so the quality checkpoint is the right default wherever there is a GPU:
# Prod GPU: WHISPER_MODEL=large-v3 WHISPER_DEVICE=cuda WHISPER_COMPUTE=float16
# (large-v3-turbo is the fast one, not the accurate one — it desyncs captions;
# the pipeline logs a warning when it is configured.)
# WHISPER_MODEL=small
# WHISPER_DEVICE=cpu
# WHISPER_COMPUTE=int8

# Transcription backend: whisper (default) | parakeet | groq. Parakeet (NVIDIA
# parakeet-tdt-0.6b-v3 via onnx-asr, GPU image only) is ~2x faster than
# whisper-turbo-GPU and auto-falls-back to whisper on errors or languages
# outside its 25 European ones. groq runs ASR fully in the cloud (zero local
# AI compute) and falls back to local whisper on API errors.
# TRANSCRIBE_BACKEND=whisper

# Groq cloud ASR (TRANSCRIBE_BACKEND=groq). Audio is ffmpeg-extracted to
# 16kHz mono FLAC, split under the upload cap, and sent to the
# OpenAI-compatible endpoint. Word timestamps need whisper-large-v3
# (large-v3-turbo doesn't support word granularity). Free tier at
# console.groq.com, no credit card.
# GROQ_API_KEY=
# GROQ_ASR_MODEL=whisper-large-v3
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_MAX_UPLOAD_MB=24

# Concurrent GPU transcriptions (parakeet or whisper-on-cuda). Keep 1.
# ASR_GPU_CONCURRENCY=1

# Video encoder for all ffmpeg encodes: x264 (default) | nvenc | auto.
# auto probes h264_nvenc once at startup and falls back to x264 if unusable.
# FFMPEG_ENCODER=x264

# Product analytics (optional, off by default). Both are read by the dashboard
# at BUILD time. Leave them unset and the frontend initialises no analytics and
# loads no third-party script. Set them to your own OpenPanel instance — and add
# your hostname to ANALYTICS_HOSTS in dashboard/index.html — to collect your own.
# VITE_OPENPANEL_API_URL=https://api.openpanel.example.com
# VITE_OPENPANEL_CLIENT_ID=your_openpanel_client_id

# Thumbnail Studio: creative text model (titles, concepts) and the image model.
# Not tied to GEMINI_MODEL on purpose: flash-lite is fine for closed choices,
# visibly worse at titles.
GEMINI_MODEL_THUMBNAIL=gemini-3.7-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Moment picker on your own model instead of Gemini (self-host). Any
# OpenAI-compatible chat endpoint: Ollama, LM Studio, vLLM, llama.cpp,
# LocalAI, OpenRouter. With this set the Gemini key is optional; it is still
# used, if present, for the frame-based stages (layout picker, silent videos).
# Ollama needs a context above its 4096 default: OLLAMA_CONTEXT_LENGTH=16384.
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_MODEL=qwen2.5:14b
# LLM_API_KEY=
# LLM_SCORE_BATCH=3
# LLM_TIMEOUT=600
# Cap on one completion. Worth setting for a reasoning model (gpt-oss spends
# 100-200 tokens thinking even on trivial replies): left at the server's own
# default, that thinking can eat the budget and leave an empty generation, which
# the JSON validator rejects. Only costs anything when the tokens are used.
# LLM_MAX_TOKENS=16384
# Token budget for the moment picker, in tokens/minute. Left unset, the budget
# is learned from the server's own x-ratelimit-limit-tokens header (Groq's free
# tier reports 8000) and calls are paced to fit it, so a long video stops dying
# at clip selection with 429s. Set it only for a provider that advertises none.
# LLM_TPM_LIMIT=8000
# How many times a rate-limited call is retried, waiting out the token window
# each time. Default 4.
# LLM_RATE_LIMIT_ATTEMPTS=4
# Clip-picking calls to run at once (--max-concurrent sets this per run).
# Default 1: pacing keeps one worker inside the budget and free tiers are fast
# enough that 34 windows score in a couple of minutes.
# CLIP_SCORE_CONCURRENCY=1

# Hard daily ceiling for the per-GB paid proxy (UTC day, MB). Above it,
# DataImpulse is removed from every chain until midnight and the jobs that
# needed it fail with a clear error. 0 disables the cap. Default 500.
# PAID_PROXY_DAILY_MB=500

# How long finished jobs (and their clips) live in output/. Self-host
# default is 24h; 7 days keeps a week of clips before the sweeper ages
# them out. The sweeper prints every purge to the server logs.
JOB_RETENTION_SECONDS=604800

# Where ASR scratch lives: the Groq path ffmpeg-extracts a large FLAC here
# BEFORE calling the API. The system temp defaults to the OS drive, which
# fills up (C: at 232MB makes every Groq job die at extraction with ENOSCP
# before the API is reached — the fallback then OOMs on local whisper).
# Any path works; a drive with room is what matters. Unset = auto-pick the
# roomiest of E:/D:/C: plus the system temp.
# ASR_TMPDIR=E:\openshorts_asr
